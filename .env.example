# ShortMaker local backend environment template
# Copy this file to `.env` in the project root, then fill the values step by step.
#
# Recommended order:
# 1. DATABASE_URL
# 2. CLERK_ISSUER
# 3. SHORTMAKER_SECRET_KEY
# 4. SHORTMAKER_ADMIN_EMAILS
# 5. Frontend origin / host values
# 6. YouTube OAuth URLs
# 7. Optional AI and publishing secrets
#
# Notes:
# - Do not commit your filled `.env` file.
# - The backend reads these values from `.env`.
# - The frontend uses `frontend/.env.local` for Vite-only values.

# Step 1: Neon / Postgres connection string.
# Required for shared users, daily quota tracking, job ownership, and persistence.
# Format example:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://replace_me

# Step 2: Clerk issuer URL for backend token validation.
# Required for any authenticated API route.
# Use your Clerk frontend API / issuer URL exactly, with no trailing slash.
# Example:
# CLERK_ISSUER=https://rational-foxhound-1.clerk.accounts.dev
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# Step 3: Secret encryption key for local encrypted config storage.
# Required if you want admin-entered secrets to be stored encrypted in `.env.json`.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this is missing, the admin UI can still use env vars, but it will refuse to persist new secret values.
SHORTMAKER_SECRET_KEY=replace_with_fernet_key

# Step 4: Admin allowlist for `/ashmil2010` admin actions.
# Required if you want any user to access YouTube/admin configuration routes.
# Comma-separated email list from Clerk users.
# Example:
# SHORTMAKER_ADMIN_EMAILS=you@example.com,team@example.com
SHORTMAKER_ADMIN_EMAILS=creator@example.com

# Optional admin allowlist by Clerk user id.
# Use this instead of, or in addition to, email allowlisting.
# Example:
# SHORTMAKER_ADMIN_USER_IDS=user_123,user_456
# SHORTMAKER_ADMIN_USER_IDS=

# Step 5: Allowed browser origins for CORS.
# Required in production. For local development, keep the localhost / 127.0.0.1 defaults.
# Add every frontend origin that will call the API.
SHORTMAKER_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Step 6: Allowed request host headers.
# Required in production. For local development, keep localhost / 127.0.0.1.
# In production, this should be only your public domain(s).
SHORTMAKER_ALLOWED_HOSTS=127.0.0.1,localhost

# Step 7: Optional callback allowlist for outbound job callbacks.
# Leave blank unless you intentionally use the upload callback feature.
# This blocks SSRF by only allowing callbacks to explicit public hostnames.
# Example:
# SHORTMAKER_ALLOWED_CALLBACK_HOSTS=hooks.example.com,api.example.com
SHORTMAKER_ALLOWED_CALLBACK_HOSTS=

# Step 8: Public base URL of the app for YouTube OAuth.
# Required if you use YouTube publishing.
# Local example:
# SHORTMAKER_YOUTUBE_OAUTH_BASE_URL=http://127.0.0.1:8000
SHORTMAKER_YOUTUBE_OAUTH_BASE_URL=http://127.0.0.1:8000

# Step 9: Exact YouTube OAuth callback URI registered in Google Cloud.
# Required if you use YouTube publishing.
# This must exactly match the Google OAuth client redirect URI.
SHORTMAKER_YOUTUBE_OAUTH_CALLBACK_URI=http://127.0.0.1:8000/youtube/oauth/callback

# Step 10: Optional Gemini API key for AI highlight selection.
# If blank, Gemini features stay disabled unless the key is saved through the admin UI.
GEMINI_API_KEY=

# Step 11: Optional Groq API key for faster transcription / AI helpers.
GROQ_API_KEY=

# Step 12: Optional Firecrawl API key for trend discovery features.
FIRECRAWL_API_KEY=

# Step 13: Optional YouTube OAuth client id.
# Recommended for deployment, because env-based secrets survive redeploys.
# If blank, you can still save it via the admin UI when SHORTMAKER_SECRET_KEY is configured.
YOUTUBE_CLIENT_ID=

# Step 14: Optional YouTube OAuth client secret.
# Recommended for deployment, because env-based secrets survive redeploys.
YOUTUBE_CLIENT_SECRET=

# Step 15: Optional YouTube refresh token.
# Recommended for deployment if you want the YouTube connection to survive restarts/redeploys.
# If blank, the app will use the encrypted token stored in `.env.json` when available.
YOUTUBE_REFRESH_TOKEN=

# Optional backend auth audience check for Clerk JWT validation.
# Leave blank unless you intentionally configured a custom audience in Clerk.
# CLERK_AUDIENCE=

# Optional override if you want to point the backend at a different database env name.
# SHORTMAKER_DATABASE_URL=
