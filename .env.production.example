# ShortMaker production environment template
# Use this file as a checklist when adding env vars to Render, Railway, Docker, or another host.
#
# Recommended order:
# 1. Core required values
# 2. Security allowlists
# 3. Public base URLs
# 4. AI provider keys
# 5. YouTube publishing credentials
# 6. Performance tuning values

# 1. Required: production Postgres database.
DATABASE_URL=postgresql://replace_me

# 2. Required: Vite/React Clerk publishable key for the frontend build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# 3. Required: Clerk issuer URL for backend token verification.
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# 4. Required if you want encrypted secret persistence outside raw env vars.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHORTMAKER_SECRET_KEY=replace_with_fernet_key

# 5. Required: who is allowed to use the admin console and shared YouTube publishing routes.
SHORTMAKER_ADMIN_EMAILS=creator@example.com

# Optional alternative or additional admin allowlist by Clerk user id.
# SHORTMAKER_ADMIN_USER_IDS=

# 6. Required: production mode toggles.
SHORTMAKER_ENV=production
SHORTMAKER_PUBLIC_DOCS=false

# 7. Required: only allow your deployed frontend origin(s).
# Add all real public origins, comma-separated.
SHORTMAKER_ALLOWED_ORIGINS=https://shortmaker.onrender.com

# 8. Required: only allow your public host header(s).
SHORTMAKER_ALLOWED_HOSTS=shortmaker.onrender.com

# 9. Optional: upload callback allowlist.
# Leave blank unless you intentionally use the callback feature.
SHORTMAKER_ALLOWED_CALLBACK_HOSTS=

# 9b. Recommended: keep private callback hosts disabled in production.
SHORTMAKER_ALLOW_PRIVATE_CALLBACKS=false

# 10. Required if using YouTube OAuth in production.
SHORTMAKER_YOUTUBE_OAUTH_BASE_URL=https://shortmaker.onrender.com

# 11. Required if using YouTube OAuth in production.
# Must exactly match the redirect URI registered in Google Cloud.
SHORTMAKER_YOUTUBE_OAUTH_CALLBACK_URI=https://shortmaker.onrender.com/youtube/oauth/callback

# 12. Optional AI provider keys.
GEMINI_API_KEY=replace_with_gemini_key
GROQ_API_KEY=replace_with_groq_key
FIRECRAWL_API_KEY=replace_with_firecrawl_key

# 13. Recommended for production YouTube publishing.
# Using env vars here is more durable than relying on local files.
YOUTUBE_CLIENT_ID=replace_with_google_client_id
YOUTUBE_CLIENT_SECRET=replace_with_google_client_secret
YOUTUBE_REFRESH_TOKEN=

# Optional: Clerk audience validation if you use a custom JWT audience.
# CLERK_AUDIENCE=

# Optional Groq / local ASR tuning.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_MODEL=base

# Optional FFmpeg output tuning.
SHORTMAKER_VIDEO_PRESET=veryfast
SHORTMAKER_VIDEO_CRF=18

# Standard web port.
PORT=8000

# Optional for local whisper ASR fallback
# OPENWHISPER_INSTALL_LOCAL=1
