# ShortMaker frontend (Vite) environment template
# Copy this file to `frontend/.env.local` for local development.
#
# Required:
# - VITE_CLERK_PUBLISHABLE_KEY
#
# Optional:
# - VITE_API_BASE_URL if the API is hosted on a different origin than the frontend.

# Step 1: Clerk publishable key for the React frontend.
# Example:
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Step 2: Optional API base URL.
# Recommended local Vite setup: leave this unset and use the built-in dev proxy
# to forward API routes to http://127.0.0.1:8000.
#
# Set this only when the frontend must call a different API origin directly.
# Example:
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# With the default proxy-first setup, keep it blank:
# VITE_API_BASE_URL=
